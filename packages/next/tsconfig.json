{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": false,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": [
    "src/create-section-pack-route.ts",
    "src/zip-pack.ts",
    "src/SectionPackCatalog.tsx",
    "src/index.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
