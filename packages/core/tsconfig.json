{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": false,
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": [
    "src/types.ts",
    "src/variables.ts",
    "src/recipes.ts",
    "src/behavior-briefs.ts",
    "src/analyze-section.ts",
    "src/draft-brief.ts",
    "src/manifest.ts",
    "src/build-section-pack.ts",
    "src/multi-section-pack.ts",
    "src/build-section-zip.ts",
    "src/zip-store.ts",
    "src/validate.ts",
    "src/schema.ts",
    "src/pack-cache.ts",
    "src/diff-pack.ts",
    "src/snapshot-pack.ts",
    "src/section-graph.ts",
    "src/spec-to-behavior.ts",
    "src/registry.ts",
    "src/ir-to-specs.ts",
    "src/tokens-from-ir.ts",
    "src/recipe-from-ir.ts",
    "src/ir-to-registry.ts",
    "src/spec-budget.ts",
    "src/visual-diff.ts",
    "src/visual-diff-shim.d.ts",
    "src/index.ts"
  ],
  "exclude": ["dist", "node_modules", "scripts", "fixtures"]
}
