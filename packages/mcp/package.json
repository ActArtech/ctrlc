{
  "name": "@ctrlc/mcp",
  "version": "0.1.0",
  "description": "Lightweight MCP server for CtrlC SectionPack tools (list, pack, validate). React section packs first; not full website creation.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ctrlc-mcp": "./bin/ctrlc-mcp.mjs"
  },
  "exports": {
    ".": "./src/server.mjs",
    "./tools": "./src/tools.mjs"
  },
  "files": [
    "bin",
    "src",
    "scripts",
    "README.md"
  ],
  "scripts": {
    "start": "node ./bin/ctrlc-mcp.mjs",
    "test": "node ./scripts/test-mcp.mjs"
  },
  "dependencies": {
    "@ctrlc/core": "0.1.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
