# Dependencies
node_modules/

# Builds
dist/
build/
out/
.next/
.turbo/
*.tsbuildinfo

# Env
.env
.env.*
!.env.example

# Logs and debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example

# Test / coverage
coverage/
.nyc_output/

# Misc
*.local
.cache/
tmp/
temp/
*.zip

# Generated SectionPack library (regenerate: npm run library)
**/.ctrlc/library/

# Page capture runs (ctrlc capture --out runs/...)
runs/

# Local agent library dumps (regenerate).
# Pack snapshots under **/.ctrlc/snapshots/ ARE committed: ci.yml uses them as
# contentHash drift baselines (see "Check SectionPack contentHash drift" step).
**/.ctrlc/*.json.bak

# Optional local worktrees / OS junk
*.swp
*~

# Local research clones (do not ship third-party repos wholesale)
docs/research/impeccable-ref/
